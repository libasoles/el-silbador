{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3100",
      "startServerReadyPattern": "Ready",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/cancion/recuerdos-de-ypacarai-lhci0",
        "http://localhost:3100/nueva",
        "http://localhost:3100/articulos",
        "http://localhost:3100/articulos/usar-acordes-en-el-editor",
        "http://localhost:3100/articulos/notas-de-la-cancion",
        "http://localhost:3100/articulos/marcas-de-estructura-y-bis"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3100/(articulos)?$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3100/articulos/.+",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.73,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3100/cancion/.+",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.77,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3100/nueva$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.96,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median-run"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
